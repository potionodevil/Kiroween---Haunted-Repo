{
  "name": "haunted-repo",
  "version": "0.1.0",
  "description": "Find leaked secrets, vulnerable dependencies, insecure code and more in your repo. Guard it with a pre-commit hook, a watcher and an MCP server for Kiro.",
  "license": "MIT",
  "type": "module",
  "bin": { "haunted-repo": "dist/cli.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "https://github.com/potionodevil/Kiroween---Haunted-Repo" },
  "keywords": ["security", "secrets", "pre-commit", "mcp", "kiro", "lint"],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@haunted/core": "workspace:*",
    "@haunted/github": "workspace:*",
    "@haunted/mcp": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "fast-check": "^4.11.0",
    "vitest": "^5.1.1"
  }
}
