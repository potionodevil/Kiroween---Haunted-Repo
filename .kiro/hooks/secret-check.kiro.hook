{
  "enabled": true,
  "name": "Secret check",
  "description": "Scans changed files with the Haunted Repo secret scanner after the agent finishes, so no real key reaches a commit.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `node scripts/pre-commit.mjs --all-changed` (the Haunted Repo secret scanner on all uncommitted changes). If it reports a ghost that is not an obvious fake (containing EXAMPLE or FAKE), stop, show the masked finding and tell the user to remove it before committing. Never print the raw secret. Follow .kiro/steering/security.md."
  }
}
