{
  "enabled": true,
  "name": "Test on save",
  "description": "Runs the matching Vitest tests whenever a scanner or exorcism source file is saved.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "lib/**/*.ts",
      "lib/**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file in lib/ was saved. Run `npx vitest run --related <changed file>` and report failures. If a test fails, explain the cause in one line and propose a fix. Do not change tests to make them pass unless the requirement changed."
  }
}
